* text=auto

# ---------------------------------------------------------------------------
# Unity YAML — merged with UnityYAMLMerge, not with git's line-based merge.
# Run scripts/setup.sh to wire the tool up in this clone.
# ---------------------------------------------------------------------------
*.unity           merge=unityyamlmerge eol=lf
*.prefab          merge=unityyamlmerge eol=lf
*.asset           merge=unityyamlmerge eol=lf

# TerrainData stays binary even with Force Text serialization. Without this rule
# the eol=lf above would rewrite its bytes and corrupt it. Name terrain data
# <Name>TerrainData.asset so it matches.
*TerrainData.asset filter=lfs diff=lfs merge=lfs -text -eol

*.meta            merge=unityyamlmerge eol=lf
*.controller      merge=unityyamlmerge eol=lf
*.anim            merge=unityyamlmerge eol=lf
*.overrideController merge=unityyamlmerge eol=lf
*.mat             merge=unityyamlmerge eol=lf
*.physicMaterial  merge=unityyamlmerge eol=lf
*.physicsMaterial2D merge=unityyamlmerge eol=lf
*.playable        merge=unityyamlmerge eol=lf
*.mask            merge=unityyamlmerge eol=lf
*.brush           merge=unityyamlmerge eol=lf
*.flare           merge=unityyamlmerge eol=lf
*.lighting        merge=unityyamlmerge eol=lf
*.terrainlayout   merge=unityyamlmerge eol=lf

*.cs              text diff=csharp eol=lf
*.shader          text eol=lf
*.hlsl            text eol=lf
*.cginc           text eol=lf
*.asmdef          text eol=lf
*.uxml            text eol=lf
*.uss             text eol=lf

# ---------------------------------------------------------------------------
# Git LFS — binary assets. Without this, the repository becomes unclonable
# within months: git stores a full copy of every version of every binary.
# ---------------------------------------------------------------------------
*.png    filter=lfs diff=lfs merge=lfs -text
*.jpg    filter=lfs diff=lfs merge=lfs -text
*.jpeg   filter=lfs diff=lfs merge=lfs -text
*.gif    filter=lfs diff=lfs merge=lfs -text
*.psd    filter=lfs diff=lfs merge=lfs -text
