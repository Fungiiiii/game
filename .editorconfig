# Fungiiiii — formatting conventions and bug-only linting.
#
# Two distinct things live in this file:
#   1. Formatting (indent, charset, line endings) — editor conventions.
#   2. Analyzer severities — a linter, deliberately limited to rules that
#      catch BUGS. Style and "code quality" opinions are left at suggestion
#      or off: they belong in review, not in a build failure.
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

[*.{yml,yaml,json,md}]
indent_size = 2

[*.{unity,prefab,asset,mat,anim,controller,meta}]
# Unity-owned YAML — never reformatted by an editor
trim_trailing_whitespace = false
insert_final_newline = false

[*.cs]

# ---------------------------------------------------------------------------
# Microsoft.Unity.Analyzers — see docs/linting.md for installation.
# Rule categories below follow Microsoft's own classification.
# ---------------------------------------------------------------------------

# --- Correctness: these are bugs. Break the build. ---
dotnet_diagnostic.UNT0004.severity = error   # Time.fixedDeltaTime used with Update
dotnet_diagnostic.UNT0006.severity = error   # Incorrect message signature
dotnet_diagnostic.UNT0007.severity = error   # Null coalescing on Unity objects
dotnet_diagnostic.UNT0008.severity = error   # Null propagation on Unity objects
dotnet_diagnostic.UNT0009.severity = error   # Missing static constructor with InitializeOnLoad
dotnet_diagnostic.UNT0012.severity = error   # Unused coroutine return value
dotnet_diagnostic.UNT0013.severity = error   # Invalid or redundant SerializeField attribute
dotnet_diagnostic.UNT0020.severity = error   # MenuItem attribute used on non-static method
dotnet_diagnostic.UNT0023.severity = error   # Coalescing assignment on Unity objects
dotnet_diagnostic.UNT0025.severity = error   # Input.GetKey overloads with KeyCode argument
dotnet_diagnostic.UNT0027.severity = error   # Do not call PropertyDrawer.OnGUI()
dotnet_diagnostic.UNT0029.severity = error   # Pattern matching with null on Unity objects
dotnet_diagnostic.UNT0030.severity = error   # Calling Destroy/DestroyImmediate on a Transform
dotnet_diagnostic.UNT0031.severity = error   # Asset operations in LoadAttribute method
dotnet_diagnostic.UNT0033.severity = error   # Incorrect message case
dotnet_diagnostic.UNT0040.severity = error   # GameObject.isStatic is editor-only
dotnet_diagnostic.UNT0043.severity = error   # Possible typo in conditional compilation symbol

# --- Type safety: also bugs. Break the build. ---
dotnet_diagnostic.UNT0003.severity = error   # Usage of non-generic GetComponent
dotnet_diagnostic.UNT0010.severity = error   # Component instance creation with new
dotnet_diagnostic.UNT0011.severity = error   # ScriptableObject instance creation with new
dotnet_diagnostic.UNT0014.severity = error   # GetComponent with non-Component/non-Interface type
dotnet_diagnostic.UNT0015.severity = error   # Incorrect signature with InitializeOnLoadMethod etc.
dotnet_diagnostic.UNT0016.severity = error   # Unsafe way to get the method name

# --- Project rules encoded as lint ---
dotnet_diagnostic.UNT0041.severity = warning # Use Animator.StringToHash — required by unity-runtime-code

# --- Off: conflicts with a project rule ---
# unity-runtime-code says do not overuse [RequireComponent].
dotnet_diagnostic.UNT0039.severity = none    # Use RequireComponent when self-invoking GetComponent

# --- Performance: visible, never blocking. ---
# CLAUDE.md requires profiling before optimizing, so these stay advisory.
dotnet_diagnostic.UNT0001.severity = suggestion
dotnet_diagnostic.UNT0002.severity = suggestion
dotnet_diagnostic.UNT0017.severity = suggestion
dotnet_diagnostic.UNT0018.severity = suggestion
dotnet_diagnostic.UNT0019.severity = suggestion
dotnet_diagnostic.UNT0022.severity = suggestion
dotnet_diagnostic.UNT0024.severity = suggestion
dotnet_diagnostic.UNT0026.severity = suggestion
dotnet_diagnostic.UNT0028.severity = suggestion
dotnet_diagnostic.UNT0032.severity = suggestion
dotnet_diagnostic.UNT0036.severity = suggestion
dotnet_diagnostic.UNT0037.severity = suggestion
dotnet_diagnostic.UNT0038.severity = suggestion
dotnet_diagnostic.UNT0042.severity = suggestion
dotnet_diagnostic.UNT0044.severity = suggestion
dotnet_diagnostic.UNT0045.severity = suggestion
dotnet_diagnostic.UNT0046.severity = suggestion

# --- Off: pure readability opinions. ---
dotnet_diagnostic.UNT0034.severity = none    # A Vector3 can be converted into a Vector2
dotnet_diagnostic.UNT0035.severity = none    # A Vector2 can be converted into a Vector3

# ---------------------------------------------------------------------------
# Style preferences — suggestions only, never build failures.
# ---------------------------------------------------------------------------
dotnet_naming_rule.private_fields_camel_case.severity = suggestion
dotnet_naming_rule.private_fields_camel_case.symbols = private_fields
dotnet_naming_rule.private_fields_camel_case.style = camel_case
dotnet_naming_symbols.private_fields.applicable_kinds = field
dotnet_naming_symbols.private_fields.applicable_accessibilities = private
dotnet_naming_style.camel_case.capitalization = camel_case

csharp_prefer_braces = true:suggestion
csharp_style_var_when_type_is_apparent = true:suggestion
csharp_style_var_elsewhere = false:suggestion
dotnet_style_readonly_field = true:suggestion
